# Copy file này thành .env (chấm env) để dùng ở local
# Hoặc khai báo biến môi trường này khi deploy web thật (Ví dụ: trên Cloudflare Pages)

# URL của Backend Cloudflare Worker (Worker chạy D1 Database)
# Thay bằng link worker thật của bạn sau khi chạy npm run deploy:worker
VITE_WORKER_URL=https://api-monitor-backend.YOUR-SUBDOMAIN.workers.dev
